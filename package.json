{
  "name": "ridesync",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time group ride coordination",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"node server/index.js\" \"npm run dev --prefix client\"",
    "start": "node server/index.js",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
